# Environment Configuration for SaveCircle MVP

# Node / Backend
NODE_ENV=development
PORT=4000
API_PREFIX=api

# PostgreSQL Database (Render Managed or Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/savecircle?schema=public

# Authentication & Security
JWT_SECRET=savecircle-super-secret-jwt-key-2026-production
JWT_EXPIRES_IN=7d
WALLET_CHALLENGE_TIMEOUT_SECONDS=300

# Stellar Network & Soroban RPC
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SAVECIRCLE_CONTRACT_ID=CDSNM3LJEEDHPHKQBEUA5FS42SUMAWTEEKWHAIVWJYYYT6QY3B5HNYNB
USDC_TOKEN_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Background Indexer
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=5000
